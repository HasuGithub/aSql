<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        xmlns:viewModels="clr-namespace:aSql.ViewModels"
        xmlns:ui="using:FluentAvalonia.UI.Controls"
        xmlns:views1="clr-namespace:aSql.Views"
        x:Class="aSql.Views.MainWindow"
        x:DataType="viewModels:MainWindowViewModel"
        mc:Ignorable="d"
        Width="1400" Height="930"
        Background="#FF26282C"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/database-svgrepo-com.ico"
        Title="aSql"
        ExtendClientAreaToDecorationsHint="True"
        WindowDecorations="BorderOnly">
  <Window.Resources>
  </Window.Resources>
  <Window.Styles>
    <Style Selector="Button.commitActionButton:disabled">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.commitActionButton:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <Style Selector="Button.rollbackActionButton:disabled">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.rollbackActionButton:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <!-- Normaler Zustand: Dünner Custom-Rand als visuelle Ergänzung -->
    <Style Selector="Window Border#RootBorder">
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="#3F3F46" />
    </Style>

    <!-- Maximierter Zustand: Rand ausblenden -->
    <Style Selector="Window:maximized Border#RootBorder">
      <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="WindowDrawnDecorations /template/ Panel#PART_TitleTextPanel">
      <Setter Property="IsVisible" Value="False" />
    </Style>

  </Window.Styles>

  <Design.DataContext>
    <viewModels:MainWindowViewModel />
  </Design.DataContext>

  <Border Name="RootBorder" BorderBrush="DarkMagenta">
    <Grid RowDefinitions="Auto,Auto,*,Auto" ColumnDefinitions="*">

      <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="4,0" Height="33">
        <StackPanel Grid.Column="0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Spacing="4">

          <Button Width="30"
                  Height="28"
                  Padding="0"
                  Click="ButtonNewInstance_OnClick"
                  ToolTip.Tip="Neue Instanz">
            <mi:MaterialIcon Kind="WindowOpen" Width="16" Height="16" Foreground="CornflowerBlue" />
          </Button>

          <Border Width="1" Height="22" Background="#FF8B8B8B" Margin="6,0,2,0" VerticalAlignment="Center" />


          <Border x:Name="WithNoLockBorder"
                  BorderBrush="Transparent"
                  BorderThickness="1"
                  CornerRadius="3"
                  IsVisible="{CompiledBinding IsWithNoLockVisible}">
            <ToggleButton x:Name="WithNoLockButton"
                          MinWidth="36"
                          Height="30"
                          Padding="0"
                          Background="Transparent"
                          BorderBrush="Transparent"
                          BorderThickness="0"
                          ToolTip.Tip="Fügt WITH(NOLOCK) hinter FROM/JOIN-Tabellen ein"
                          IsChecked="{CompiledBinding WithNoLock, Mode=TwoWay}">
              <mi:MaterialIcon Kind="LockOffOutline" Width="18" Height="18" Foreground="#FF60A5FA" />
            </ToggleButton>
          </Border>

          <Border x:Name="WithDelimiter"
                  BorderBrush="Transparent"
                  BorderThickness="1"
                  CornerRadius="3"
                  IsVisible="True">
            <ToggleButton x:Name="WithDelimiterButton"
                          MinWidth="36"
                          Height="30"
                          Padding="0"
                          Background="Transparent"
                          BorderBrush="Transparent"
                          BorderThickness="0"
                          ToolTip.Tip="Erzeugt SQL mit Table/ und Field-Delimiter"
                          IsChecked="{CompiledBinding WithDelimiter, Mode=TwoWay}">
              <mi:MaterialIcon Kind="CodeBraces" Width="18" Height="18" Foreground="#FF60A5FA" />
            </ToggleButton>
          </Border>

          <Border x:Name="UseUpperCase"
                  BorderBrush="Transparent"
                  BorderThickness="1"
                  CornerRadius="3"
                  IsVisible="True">
            <ToggleButton x:Name="UseUpperCaseButton"
                          MinWidth="36"
                          Height="30"
                          Padding="0"
                          Background="Transparent"
                          BorderBrush="Transparent"
                          BorderThickness="0"
                          ToolTip.Tip="Erzeugt SQL mit Großbuchstaben"
                          IsChecked="{CompiledBinding UseUpperCaseSql, Mode=TwoWay}">
              <mi:MaterialIcon Kind="FormatLetterCaseUpper" Width="18" Height="18" Foreground="#FF60A5FA" />
            </ToggleButton>
          </Border>

          <Border x:Name="UseTopBorder"
                  BorderBrush="Transparent"
                  BorderThickness="1"
                  CornerRadius="3"
                  IsVisible="{CompiledBinding IsUseTopVisible}">
            <ToggleButton x:Name="UseTopButton"
                          MinWidth="36"
                          Height="30"
                          Padding="0"
                          Background="Transparent"
                          BorderBrush="Transparent"
                          BorderThickness="0"
                          ToolTip.Tip="Fügt TOP(Count) hinter SELECT ein (Count = Max-Zeilen)"
                          IsChecked="{CompiledBinding UseTopEnabled, Mode=TwoWay}">
              <mi:MaterialIcon Kind="FormatVerticalAlignTop" Width="18" Height="18" Foreground="#FF60A5FA" />
            </ToggleButton>
          </Border>

          <Border x:Name="UseSimpleDateBorder"
                  BorderBrush="Transparent"
                  BorderThickness="1"
                  CornerRadius="3"
                  IsVisible="{CompiledBinding IsUseTopVisible}">
            <ToggleButton x:Name="UseSimpleDateButton"
                          MinWidth="36"
                          Height="30"
                          Padding="0"
                          Background="Transparent"
                          BorderBrush="Transparent"
                          BorderThickness="0"
                          ToolTip.Tip="Nutzt ein einfaches, kurzes Datumsformat für Bedingungen"
                          IsChecked="{CompiledBinding UseSimpleDate, Mode=TwoWay}">
              <mi:MaterialIcon Kind="CalendarDay" Width="18" Height="18" Foreground="#FF60A5FA" />
            </ToggleButton>
          </Border>

          <Border Width="1" Height="22" Background="#FF8B8B8B" Margin="6,0,2,0" VerticalAlignment="Center" />

        </StackPanel>

        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Margin="0,0,15,0"
                    Spacing="6">
          <Button Width="20"
                  Height="20"
                  Padding="0"
                  BorderBrush="Transparent"
                  BorderThickness="0"
                  Background="Transparent"
                  ToolTip.Tip="Command-Timeout verringern"
                  Command="{CompiledBinding SqlEditor.DecreaseCommandTimeoutCommand}">
            <mi:MaterialIcon Kind="ChevronLeft" Width="14" Height="14" Foreground="#FFE0E0E0" />
          </Button>

          <Border MinWidth="56"
                  Height="24"
                  VerticalAlignment="Center"
                  BorderBrush="#FF8B8B8B"
                  BorderThickness="1"
                  CornerRadius="3"
                  Padding="8,0">
            <TextBlock VerticalAlignment="Center"
                       ToolTip.Tip="Aktuelles Command-Timeout für SQL-Ausführung"
                       HorizontalAlignment="Center"
                       Text="{CompiledBinding SqlEditor.CommandTimeoutDisplayText}"
                       Foreground="#FFE0E0E0" />
          </Border>

          <Button Width="20"
                  Height="20"
                  Padding="0"
                  BorderBrush="Transparent"
                  BorderThickness="0"
                  Background="Transparent"
                  ToolTip.Tip="Command-Timeout erhöhen"
                  Command="{CompiledBinding SqlEditor.IncreaseCommandTimeoutCommand}">

            <mi:MaterialIcon Kind="ChevronRight" Width="14" Height="14" Foreground="#FFE0E0E0" />
          </Button>
          <Button Click="MinimizeButton_Click"
                  Width="20"
                  Height="20"
                  Padding="0"
                  BorderBrush="Transparent"
                  BorderThickness="0"
                  Background="Transparent"
                  ToolTip.Tip="Fenster minimieren"
                  CornerRadius="0">
            <mi:MaterialIcon Kind="Minimize" Width="14" Height="14" Foreground="Magenta" />
          </Button>
          <Button Click="CloseButton_Click"
                  Width="20"
                  Height="20"
                  Padding="0"
                  BorderBrush="Transparent"
                  BorderThickness="0"
                  Background="Transparent"
                  ToolTip.Tip="Anwendung/Fenster schließen"
                  CornerRadius="0">
            <mi:MaterialIcon Kind="CloseBoxesOutline" Width="14" Height="14" Foreground="Magenta" />
          </Button>
        </StackPanel>
      </Grid>

      <Grid Grid.Row="2" ColumnDefinitions="317,1.5,*">
        <Grid Grid.Column="0" RowDefinitions="4*,1.5,*">
          <views1:DbTreeView Grid.Row="0" DataContext="{CompiledBinding DbTreeView}" />

          <GridSplitter Grid.Row="1"
                        ResizeDirection="Rows"
                        Background="#FF5A005A"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Height="1" />

          <views1:StatusMessageView Grid.Row="2"
                                    DataContext="{CompiledBinding StatusMessage}" />
        </Grid>

        <GridSplitter Grid.Column="1"
                      ResizeDirection="Columns"
                      Background="#FF5A005A"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Width="1" />

        <Grid Grid.Column="2" RowDefinitions="*,1.5,*">
          <Grid Grid.Row="0" ColumnDefinitions="264.5,1.5,*">
            <views1:SqlTreeView Grid.Column="0" DataContext="{CompiledBinding SqlEditor.SqlTreeView}" />

            <GridSplitter Grid.Column="1"
                          ResizeDirection="Columns"
                          Background="#FF5A005A"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Width="1" />

            <views1:SqlEditorView Grid.Column="2" DataContext="{CompiledBinding SqlEditor}" />
          </Grid>

          <GridSplitter Grid.Row="1"
                        ResizeDirection="Rows"
                        Background="#FF5A005A"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Height="1" />

          <views1:ResultsGridView Grid.Row="2"
                                  DataContext="{CompiledBinding SqlEditor}" />

        </Grid>
      </Grid>

      <Border Grid.Row="3" x:Name="StatusBorder" BorderThickness="0" BorderBrush="Transparent" Background="#FF222428"
              Padding="8,4">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <TextBlock Grid.Column="0"
                     Text="{CompiledBinding NativeDbProviderText}"
                     FontFamily="Inter, Segoe UI, Arial"
                     FontSize="13"
                     Foreground="#FF9F59A3"
                     FontWeight="Bold"
                     VerticalAlignment="Center"
                     Margin="0,0,10,0" />

          <TextBlock Grid.Column="1"
                     Text="{CompiledBinding ConnectionStatusText}"
                     FontFamily="Inter, Segoe UI, Arial"
                     FontSize="13"
                     FontWeight="Bold"
                     Foreground="#FFB9C0C8"
                     VerticalAlignment="Center" />

        </Grid>
      </Border>

      <Grid Grid.Row="0" Grid.RowSpan="4" MinHeight="450" Background="{DynamicResource SmokeFillColorDefaultBrush}"
            IsVisible="{CompiledBinding IsLoading}">

        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="20">
          <ui:FAProgressRing IsIndeterminate="True"
                             Width="60"
                             Height="60"
                             BorderThickness="4" />

        </StackPanel>
      </Grid>

    </Grid>
  </Border>

</Window>