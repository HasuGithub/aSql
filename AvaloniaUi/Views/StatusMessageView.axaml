<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:viewModels="clr-namespace:aSql.ViewModels"
             x:Class="aSql.Views.StatusMessageView"
             x:DataType="viewModels:StatusMessageViewModel"
             mc:Ignorable="d">
  <UserControl.Styles>
    <Style Selector="ScrollViewer#StatusScrollViewer">
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ScrollViewer#StatusScrollViewer /template/ Border">
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Background" Value="#FF222428" />
    </Style>
  </UserControl.Styles>
  <Border Margin="4,2,4,4" BorderThickness="0">
    <Grid RowDefinitions="Auto,*">
      <StackPanel Grid.Row="0"
                  Orientation="Horizontal"
                  HorizontalAlignment="Left"
                  Margin="0,0,0,4"
                  Spacing="4">
        <Button Width="30"
                Height="28"
                Padding="0"
                ToolTip.Tip="Ausgewähltes Element löschen"
                Command="{CompiledBinding ClearMessageCommand}"
                IsEnabled="{CompiledBinding CanClearMessage}">
          <mi:MaterialIcon Kind="DeleteOutline" Width="16" Height="16" Foreground="OrangeRed" />
        </Button>
      </StackPanel>

      <ScrollViewer Grid.Row="1"
                    x:Name="StatusScrollViewer"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto"
                    BorderThickness="0"
                    BorderBrush="Transparent"
                    Background="#FF222428">
        <ItemsControl x:Name="StatusMessageItems"
                      ItemsSource="{CompiledBinding Entries}"
                      FontFamily="Inter, Segoe UI, Arial"
                      FontSize="10"
                      Margin="4">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="viewModels:StatusMessageEntry">
              <TextBox x:Name="StatusMessageText"
                       Text="{CompiledBinding Text}"
                       FontFamily="Inter, Segoe UI, Arial"
                       IsReadOnly="True"
                       TextWrapping="Wrap"
                       Foreground="{CompiledBinding Foreground}"
                       Background="Black"
                       Margin="0,0,0,2" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Grid>
  </Border>
</UserControl>